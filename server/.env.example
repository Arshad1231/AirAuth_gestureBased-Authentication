# Copy to .env and adjust.

PORT=5000
NODE_ENV=development

# MongoDB (local install, Docker, or Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/airauth

# Long random string - used to sign access tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Python ML service (ml-service/) and the shared secret it expects
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_API_KEY=dev-ml-service-key
ML_SERVICE_TIMEOUT_MS=30000

# Front-end origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Login security policy
LOGIN_SESSION_MINUTES=5
MAX_ATTEMPTS_PER_STEP=3
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# Keep raw captures in MongoDB so the models can be retrained (research mode)
STORE_RAW_SAMPLES=true

# =============================================================================
# FILE SUMMARY
# -----------------------------------------------------------------------------
# Template for server/.env.  Defines the HTTP port, MongoDB URI, JWT signing
# secret/lifetime, the ML service URL + shared API key, the CORS origin of the
# React client, the login security policy (session lifetime, attempts per
# step, account lockout) and whether raw biometric captures are stored for
# retraining.
# =============================================================================
